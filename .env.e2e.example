# E2E käivitub lokaalselt, kuid kasutab ainult eraldatud stagingu teenuseid.
VITE_SUPABASE_URL=https://hidyllpyecockzhqfpft.supabase.co
VITE_SUPABASE_ANON_KEY=your_staging_publishable_key

# Eraldi stagingu testkasutaja. Ära kasuta päris kliendi kontot.
E2E_USER_EMAIL=e2e-user@example.com
E2E_USER_PASSWORD=replace_with_a_strong_staging_only_password

# Valikuline: ainult siis, kui lisame hiljem Stripe checkout'i testi.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
